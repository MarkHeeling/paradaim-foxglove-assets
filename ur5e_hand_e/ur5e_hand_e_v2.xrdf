# BEVROREN: de UR5e + Hand-E waarmee v1 en v2 gemaakt zijn (cel v20): thuishouding
# [180, -60, 80, -110, -90, 0] graden en de bollenset zonder de kabelconnector.
# Alleen voor de QA van v1/v2 (planner.robot kiest hem bij cel v20), zodat het
# snapshot en de getallen in het boek blijven kloppen. Niet bewerken; de
# actuele robot staat in ur5e_hand_e.xrdf (besluit Mark 28-09-2026).

# XRDF voor UR5e + Robotiq Hand-E (paradaim bin-picking cel).

format: xrdf
format_version: 2.0

default_joint_positions:
  shoulder_pan_joint: 3.14159265
  shoulder_lift_joint: -1.04719755
  elbow_joint: 1.39626340
  wrist_1_joint: -1.91986218
  wrist_2_joint: -1.57079633
  wrist_3_joint: 0.0

cspace:
  joint_names:
    - "shoulder_pan_joint"
    - "shoulder_lift_joint"
    - "elbow_joint"
    - "wrist_1_joint"
    - "wrist_2_joint"
    - "wrist_3_joint"
  acceleration_limits: [10.0, 10.0, 10.0, 10.0, 10.0, 10.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

tool_frames: ["tool0"]

world_collision:
  geometry: "ur5e_collision_spheres"

self_collision:
  geometry: "ur5e_self_collision_spheres"
  ignore:
    shoulder_link: ["upper_arm_link"]
    upper_arm_link: ["forearm_link"]
    forearm_link: ["wrist_1_link"]
    wrist_1_link: ["wrist_2_link"]
    wrist_2_link: ["wrist_3_link"]

geometry:
  ur5e_collision_spheres:
    spheres:
      shoulder_link:
        - center: [-0.006, -0.012, 0.027]
          radius: 0.059
        - center: [0.011, 0.007, -0.048]
          radius: 0.055
        - center: [0.018, -0.031, -0.001]
          radius: 0.05
      upper_arm_link:
        - center: [0.001, 0.0, 0.135]
          radius: 0.068
        - center: [-0.03, 0.0, 0.146]
          radius: 0.069
        - center: [-0.064, 0.005, 0.125]
          radius: 0.064
        - center: [-0.11, 0.0, 0.137]
          radius: 0.069
        - center: [-0.123, -0.001, 0.151]
          radius: 0.068
        - center: [-0.156, 0.0, 0.129]
          radius: 0.069
        - center: [-0.183, 0.0, 0.15]
          radius: 0.069
        - center: [-0.226, -0.001, 0.123]
          radius: 0.068
        - center: [-0.27, -0.001, 0.151]
          radius: 0.069
        - center: [-0.307, 0.0, 0.121]
          radius: 0.069
        - center: [-0.344, 0.0, 0.126]
          radius: 0.069
        - center: [-0.359, 0.005, 0.155]
          radius: 0.064
        - center: [-0.425, 0.0, 0.142]
          radius: 0.069
        - center: [-0.426, -0.001, 0.118]
          radius: 0.067
      forearm_link:
        - center: [0.031, -0.009, 0.037]
          radius: 0.033
        - center: [-0.005, 0.001, 0.048]
          radius: 0.059
        - center: [-0.01, 0.001, 0.018]
          radius: 0.052
        - center: [-0.034, 0.0, 0.014]
          radius: 0.058
        - center: [-0.082, 0.0, 0.011]
          radius: 0.057
        - center: [-0.129, 0.0, 0.008]
          radius: 0.056
        - center: [-0.176, 0.0, 0.005]
          radius: 0.055
        - center: [-0.222, 0.0, 0.002]
          radius: 0.055
        - center: [-0.268, 0.0, -0.001]
          radius: 0.054
        - center: [-0.317, 0.0, -0.001]
          radius: 0.053
        - center: [-0.326, -0.009, 0.028]
          radius: 0.042
        - center: [-0.342, 0.0, -0.008]
          radius: 0.051
        - center: [-0.386, 0.0, 0.021]
          radius: 0.049
        - center: [-0.393, 0.001, -0.019]
          radius: 0.047
      wrist_1_link:
        - center: [0.0, 0.027, -0.002]
          radius: 0.041
        - center: [-0.003, -0.032, 0.001]
          radius: 0.037
        - center: [-0.002, -0.003, 0.0]
          radius: 0.039
        - center: [0.0, 0.0, -0.058]
          radius: 0.045
      wrist_2_link:
        - center: [0.0, 0.0, -0.015]
          radius: 0.041
        - center: [0.0, 0.018, 0.001]
          radius: 0.039
        - center: [0.0, -0.033, -0.001]
          radius: 0.04
      wrist_3_link:
        - center: [-0.001, 0.002, -0.025]
          radius: 0.038
        # Hand-E-koppeling + wrist-camera (ring rond de flens)
        - center: [0.0, 0.0, 0.018]
          radius: 0.045
        # Hand-E body
        - center: [0.0, 0.0, 0.055]
          radius: 0.042
        - center: [0.0, 0.0, 0.09]
          radius: 0.04
        # vingerbasis
        - center: [0.0, 0.0, 0.12]
          radius: 0.032
        # vingers t/m de tips (toegevoegd 2026-07-07: de tips staken ~5 mm in
        # obstakels; zie exts/paradaim.motion_panel. Grijpen blijft planbaar:
        # planner-doelen zijn altijd pregrasp/thuis en de kubus staat tijdens
        # de (planner-vrije) daling als obstakel uit. Vingerslag-as = ±X_w3.)
        - center: [0.022, 0.0, 0.14]
          radius: 0.02
        - center: [-0.022, 0.0, 0.14]
          radius: 0.02
        - center: [0.022, 0.0, 0.158]
          radius: 0.016
        - center: [-0.022, 0.0, 0.158]
          radius: 0.016
  ur5e_self_collision_spheres:
    clone: ["ur5e_collision_spheres"]
